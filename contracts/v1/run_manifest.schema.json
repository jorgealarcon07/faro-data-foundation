{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "FaroRunManifest",
  "type": "object", "required": ["contract_version","run_id","git_sha","dataset_sha256","source_namespace","data_kind","seed","as_of","rows","data_sha256","checks","dbt","environment"],
  "properties": {
    "contract_version": {"const":"1.0.0"},
    "run_id": {"type":"string","pattern":"^[a-f0-9]{32}$"},
    "git_sha": {"type":"string","minLength":1},
    "dataset_sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "data_sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "source_namespace": {"enum":["retail_uk_reference","retail_synthetic"]},
    "data_kind": {"enum":["synthetic","public_real_historical"]},
    "seed": {"type":["integer","null"]}, "as_of": {"type":"string"},
    "rows": {"type":"integer","minimum":1},
    "checks": {"type":"object","required":["status","reconciled_groups","known_signed_amount"]},
    "dbt": {"type":"object","required":["nodes","tests_passed"]}, "environment":{"type":"object"}
  },
  "allOf": [{"if":{"properties":{"data_kind":{"const":"public_real_historical"}}},"then":{"properties":{"seed":{"type":"null"},"source_namespace":{"const":"retail_uk_reference"}}}}]
}
