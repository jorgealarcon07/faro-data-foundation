{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "trend",
  "position": {
    "x": 30,
    "y": 180,
    "z": 0,
    "height": 480,
    "width": 740,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Activity"
                    }
                  },
                  "Property": "business_date"
                }
              },
              "queryRef": "Activity.business_date",
              "nativeQueryRef": "business_date"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Activity"
                    }
                  },
                  "Property": "Ventas elegibles GBP"
                }
              },
              "queryRef": "Activity.Ventas elegibles GBP",
              "nativeQueryRef": "Ventas elegibles GBP"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}
