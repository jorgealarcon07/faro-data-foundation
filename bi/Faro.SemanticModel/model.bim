{
  "name": "Faro",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "expressions": [
      {
        "name": "DataDirectory",
        "kind": "m",
        "expression": "\"C:/Users/jorge/Documents/Codex/2026-11-11/investiga-profundamente-el-mercado-laboral-actual/outputs/faro-data-foundation/reports/latest/retail_uk_reference\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      }
    ],
    "tables": [
      {
        "name": "Activity",
        "columns": [
          {
            "name": "source_namespace",
            "dataType": "string",
            "sourceColumn": "source_namespace",
            "summarizeBy": "none"
          },
          {
            "name": "data_kind",
            "dataType": "string",
            "sourceColumn": "data_kind",
            "summarizeBy": "none"
          },
          {
            "name": "currency",
            "dataType": "string",
            "sourceColumn": "currency",
            "summarizeBy": "none"
          },
          {
            "name": "business_date",
            "dataType": "dateTime",
            "sourceColumn": "business_date",
            "summarizeBy": "none"
          },
          {
            "name": "record_class",
            "dataType": "string",
            "sourceColumn": "record_class",
            "summarizeBy": "none"
          },
          {
            "name": "row_count",
            "dataType": "int64",
            "sourceColumn": "row_count",
            "summarizeBy": "none"
          },
          {
            "name": "signed_amount",
            "dataType": "double",
            "sourceColumn": "signed_amount",
            "summarizeBy": "none"
          },
          {
            "name": "unknown_amount_rows",
            "dataType": "int64",
            "sourceColumn": "unknown_amount_rows",
            "summarizeBy": "none"
          },
          {
            "name": "publication_run_id",
            "dataType": "string",
            "sourceColumn": "publication_run_id",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Activity",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "  Raw = Csv.Document(File.Contents(DataDirectory & \"/activity.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "  Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),",
                "  Nulls = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "  Typed = Table.TransformColumnTypes(Nulls, {{\"source_namespace\", type text}, {\"data_kind\", type text}, {\"currency\", type text}, {\"business_date\", type date}, {\"record_class\", type text}, {\"row_count\", Int64.Type}, {\"signed_amount\", type number}, {\"unknown_amount_rows\", Int64.Type}, {\"publication_run_id\", type text}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Filas",
            "expression": "SUM(Activity[row_count])",
            "formatString": "#,0"
          },
          {
            "name": "Importe firmado GBP",
            "expression": "SUM(Activity[signed_amount])",
            "formatString": "£#,0.00"
          },
          {
            "name": "Ventas elegibles GBP",
            "expression": "CALCULATE(SUM(Activity[signed_amount]), Activity[record_class] = \"sale\")",
            "formatString": "£#,0.00"
          }
        ]
      },
      {
        "name": "Quality",
        "columns": [
          {
            "name": "source_namespace",
            "dataType": "string",
            "sourceColumn": "source_namespace",
            "summarizeBy": "none"
          },
          {
            "name": "data_kind",
            "dataType": "string",
            "sourceColumn": "data_kind",
            "summarizeBy": "none"
          },
          {
            "name": "currency",
            "dataType": "string",
            "sourceColumn": "currency",
            "summarizeBy": "none"
          },
          {
            "name": "business_date",
            "dataType": "dateTime",
            "sourceColumn": "business_date",
            "summarizeBy": "none"
          },
          {
            "name": "input_rows",
            "dataType": "int64",
            "sourceColumn": "input_rows",
            "summarizeBy": "none"
          },
          {
            "name": "unknown_customer_rows",
            "dataType": "int64",
            "sourceColumn": "unknown_customer_rows",
            "summarizeBy": "none"
          },
          {
            "name": "quarantine_rows",
            "dataType": "int64",
            "sourceColumn": "quarantine_rows",
            "summarizeBy": "none"
          },
          {
            "name": "adjustment_rows",
            "dataType": "int64",
            "sourceColumn": "adjustment_rows",
            "summarizeBy": "none"
          },
          {
            "name": "unknown_amount_rows",
            "dataType": "int64",
            "sourceColumn": "unknown_amount_rows",
            "summarizeBy": "none"
          },
          {
            "name": "quarantined_known_amount",
            "dataType": "double",
            "sourceColumn": "quarantined_known_amount",
            "summarizeBy": "none"
          },
          {
            "name": "publication_status",
            "dataType": "string",
            "sourceColumn": "publication_status",
            "summarizeBy": "none"
          },
          {
            "name": "publication_run_id",
            "dataType": "string",
            "sourceColumn": "publication_run_id",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Quality",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "  Raw = Csv.Document(File.Contents(DataDirectory & \"/quality.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "  Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),",
                "  Nulls = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "  Typed = Table.TransformColumnTypes(Nulls, {{\"source_namespace\", type text}, {\"data_kind\", type text}, {\"currency\", type text}, {\"business_date\", type date}, {\"input_rows\", Int64.Type}, {\"unknown_customer_rows\", Int64.Type}, {\"quarantine_rows\", Int64.Type}, {\"adjustment_rows\", Int64.Type}, {\"unknown_amount_rows\", Int64.Type}, {\"quarantined_known_amount\", type number}, {\"publication_status\", type text}, {\"publication_run_id\", type text}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Filas sin cliente",
            "expression": "SUM(Quality[unknown_customer_rows])",
            "formatString": "#,0"
          },
          {
            "name": "Filas en cuarentena",
            "expression": "SUM(Quality[quarantine_rows])",
            "formatString": "#,0"
          },
          {
            "name": "Porcentaje sin cliente",
            "expression": "DIVIDE([Filas sin cliente], SUM(Quality[input_rows]))",
            "formatString": "0.00%"
          }
        ]
      }
    ]
  }
}
